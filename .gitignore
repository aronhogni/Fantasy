node_modules/
# `node_modules/` med skastriki naer EKKI yfir SYMLINK med sama nafni.
# Worktree-uppsetning notar symlink i sameiginlega node_modules og hann sast
# thvi sem ORAKID — eitt `git add -A` hefdi committad hann.
# ATH: .gitignore notar `#`, EKKI `/* */` — `/*` er MYNSTUR sem naer yfir allt
# i rot. Fyrsta tilraun min setti C-athugasemd hér og thad var haettulegt.
node_modules
dist/
# ATOMISK SKRIF SKILJA EFTIR SYSTKINA-`.tmp` EF KEYRSLA DEYR I MIDJU SKRIFI
# (25.8.2026). `writeJSON` hreinsar hana sjalf a villu, en drepist ferlid
# (SIGKILL, OOM i Actions) kemst hun aldrei ad — og tha situr hun i `data/`,
# sem ER committad. Trunkud skra sem SLAEDDIST med i commit vaeri nakvaemlega
# bilunin sem atomisku skrifin eru til ad utiloka, bara undir odru nafni.
*.tmp
# `_to_delete/` — 160 MB af snapshot-tarbollum og afritum sem notandinn
# geymir i rotinni. HUN ER OTRACKED OG A AD VERA ThAD: eitt `git add -A`
# (sem CLAUDE.md bannar einmitt, kafli 2 regla 2) myndi setja
# `fantasy_snapshot.tar.gz` og felaga BEINT I SOGUNA, thar sem thau
# haetta aldrei ad vera til. Skrain er EKKI eydd hedan — hun er
# notandans og hann kaus nafnid; thetta er adeins vord gegn slysni.
_to_delete/
.env
.env.local
# ALLAR .env-utgafur (11.8.2026). Adur voru ADEINS `.env` og `.env.local`
# skradar, svo `.env.production`, `.env.local.bak` eda `.env.keys` hefdu
# verid FYLGST MED — i PUBLIC repo-i, med fjorum API-lyklum i umferd.
# Vordurinn a leyndarmalum er "aldrei lykil i commit", og hann a ekki ad
# vera undir thvi ad nafnid se nakvaemlega eitt af tveimur.
.env.*
.cache-nfl/
nfl/.cache-nfl/
nfl/node_modules/
nfl/dist/
# StatsBomb-atburdir sem measure-box-touches.mjs cache-ar (~600 MB rannsoknargogn)
scripts/.boxtouch-cache/

# Rannsoknar-skyndiminni fyrir maelinga-lob. HRAGOGN, ekki nidurstodur:
# avail-lab.mjs saekir ~7 MB af nflverse-meidslaskram og cache-ar thau svo
# endurkeyrsla se sekundur i stad minutna. Nidurstodan er i
# nfl/data/measure/avail.json og HUN er committud; hraskrarnar eru
# endurhladanlegar og eiga ekki ad vera i opinberu repo-i.
nfl/scripts/.avail-cache/

# E1 (Championship) CSV sem measure-promoted-proxy.mjs cache-ar. Timabil sem
# er lokid breytist ekki, svo skrarnar eru sottar EINU SINNI (15 talsins,
# ~5 MB). Maelinga-inntak, ekki app-gogn — data/ ber engar E1-skrar.
scripts/.e1-cache/
